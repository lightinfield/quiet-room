---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { SECTIONS, SITE } from '../../data/site';
import { byNewest, isPublished } from '../../utils/content';

const entries = (await getCollection('library')).filter(isPublished).sort(byNewest);
const featured = entries.filter((entry) => entry.data.featured).slice(0, 6);
const latest = (featured.length >= 3 ? featured : entries).slice(0, 6);
const base = import.meta.env.BASE_URL;
const url = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout title="首页" description={SITE.description}>
  <section class="home-intro">
    <div class="home-hero-inner">
      <h1>{SITE.name}</h1>
      <p>在这里安静读经、学习、记录，也把所信的带回日常生活。</p>
    </div>
  </section>

  <section class="home-section" aria-labelledby="areas-title">
    <div class="section-heading">
      <div><h2 id="areas-title">内容目录</h2></div>
      <p>按内容进入，也可以通过索引与搜索交叉查找。</p>
    </div>
    <div class="section-grid">
      {Object.values(SECTIONS).map((section) => (
        <a class="section-tile" href={url(section.href)}>
          <div><h3>{section.title}</h3><p>{section.description}</p></div>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="latest-title">
    <div class="section-heading">
      <div><h2 id="latest-title">最近整理</h2></div>
      <a class="text-link" href={url('/index/')}>全部索引</a>
    </div>
    <div class="content-grid">
      {latest.map((entry) => <ContentCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
