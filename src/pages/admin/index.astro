---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS, SITE } from '../../data/site';
const repoContent = `${SITE.repository}/tree/main/src/content/library`;
---

<BaseLayout title="内容工作台" description="为静室快速生成标准 Markdown 内容文件。">
  <div class="admin-shell">
    <header class="section-header" style="padding-top:0">
      <p class="page-kicker">CONTENT STUDIO</p>
      <h1 class="page-title">内容工作台</h1>
      <p class="page-lead">填写元数据和正文，自动生成符合站点规范的 Markdown 文件。下载后上传到 GitHub 内容目录，部署会自动完成分类、索引和搜索更新。</p>
    </header>
    <div class="admin-grid">
      <section class="admin-panel">
        <h2>新建内容</h2>
        <div class="form-grid">
          <div class="field"><label for="editor-section">栏目</label><select id="editor-section">{Object.entries(SECTIONS).map(([key, section]) => <option value={key}>{section.title}</option>)}</select></div>
          <div class="field"><label for="editor-date">日期</label><input id="editor-date" type="date" /></div>
          <div class="field full"><label for="editor-title">标题</label><input id="editor-title" placeholder="例如：在震动世界中安静认识神" /></div>
          <div class="field"><label for="editor-slug">英文 slug</label><input id="editor-slug" placeholder="be-still-know-god" pattern="[a-z0-9-]+" /></div>
          <div class="field"><label for="editor-collection">类目 slug</label><input id="editor-collection" placeholder="psalms" /></div>
          <div class="field full"><label for="editor-summary">摘要</label><input id="editor-summary" placeholder="一两句话说明这篇内容解决什么问题" /></div>
          <div class="field"><label for="editor-scripture">经文（逗号分隔）</label><input id="editor-scripture" placeholder="诗篇 46, 罗马书 8:28" /></div>
          <div class="field"><label for="editor-tags">标签（逗号分隔）</label><input id="editor-tags" placeholder="bible/psalms, practice/prayer" /></div>
          <div class="field full"><label for="editor-body">正文（Markdown）</label><textarea id="editor-body" placeholder="## 核心观察&#10;&#10;从这里开始写……"></textarea></div>
        </div>
        <div class="admin-actions">
          <button class="button" type="button" data-editor-download>下载 .md</button>
          <button class="button-ghost" type="button" data-editor-copy>复制 Markdown</button>
          <a class="button-ghost" href={repoContent} rel="noreferrer">打开 GitHub 内容目录</a>
        </div>
      </section>
      <section class="admin-panel"><h2>文件预览</h2><pre class="admin-preview" data-editor-preview>开始填写左侧内容后，这里会生成标准文件。</pre></section>
    </div>
  </div>

  <script is:inline>
    (() => {
      const ids = ['section','date','title','slug','collection','summary','scripture','tags','body'];
      const els = Object.fromEntries(ids.map(id => [id, document.querySelector(`#editor-${id}`)]));
      const preview = document.querySelector('[data-editor-preview]');
      if (!els.date.value) els.date.value = new Date().toISOString().slice(0,10);
      const esc = (v) => String(v || '').replace(/"/g, '\\"');
      const list = (v) => String(v || '').split(',').map(x => x.trim()).filter(Boolean).map(x => `"${esc(x)}"`).join(', ');
      const build = () => {
        const slug = els.slug.value.trim() || 'new-note';
        const collection = els.collection.value.trim() || 'uncategorized';
        return `---\ntitle: "${esc(els.title.value || '未命名内容')}"\nslug: ${slug}\nsection: ${els.section.value}\ncollection: { title: "${collection}", slug: ${collection} }\ndate: ${els.date.value}\nsummary: "${esc(els.summary.value || '待补充摘要')}"\nscripture: [${list(els.scripture.value)}]\nconfession: []\ntags: [${list(els.tags.value)}]\nfeatured: false\norder: 0\n---\n\n${els.body.value || '## 开始记录\n\n在这里写正文。'}\n`;
      };
      const refresh = () => preview.textContent = build();
      Object.values(els).forEach(el => el.addEventListener('input', refresh));
      refresh();
      document.querySelector('[data-editor-copy]')?.addEventListener('click', async (event) => {
        await navigator.clipboard.writeText(build());
        event.currentTarget.textContent = '已复制';
        setTimeout(() => event.currentTarget.textContent = '复制 Markdown', 1200);
      });
      document.querySelector('[data-editor-download]')?.addEventListener('click', () => {
        const blob = new Blob([build()], { type:'text/markdown;charset=utf-8' });
        const href = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = href; a.download = `${els.slug.value.trim() || 'new-note'}.md`; a.click();
        URL.revokeObjectURL(href);
      });
    })();
  </script>
</BaseLayout>
