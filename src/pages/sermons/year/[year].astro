---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { byNewest, isPublished } from '../../../utils/content';

export async function getStaticPaths() {
  const entries = (await getCollection('library')).filter(isPublished).filter((entry) => entry.data.section === 'sermons');
  const years = [...new Set(entries.map((entry) => entry.data.date.getFullYear()))];
  return years.map((year) => ({ params: { year: String(year) }, props: { year } }));
}

const { year } = Astro.props;
const entries = (await getCollection('library'))
  .filter(isPublished)
  .filter((entry) => entry.data.section === 'sermons' && entry.data.date.getFullYear() === year)
  .sort(byNewest);
const base = import.meta.env.BASE_URL;
const url = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout title={`${year} 年主日证道`} description={`按时间归档的 ${year} 年主日证道。`}>
  <div class="page-shell">
    <header class="section-header">
      <nav class="breadcrumb" aria-label="面包屑"><a href={url('/study/')}>首页</a><span aria-hidden="true">/</span><a href={url('/sermons/')}>主日证道</a><span aria-hidden="true">/</span><span>{year}</span></nav>
      <p class="page-kicker">SERMON ARCHIVE</p>
      <h1 class="page-title">{year} 年主日证道</h1>
      <p class="page-lead">按主日日期倒序整理，同时保留经卷、系列与主题关联。</p>
    </header>
    <div class="content-grid">{entries.map((entry) => <ContentCard entry={entry} />)}</div>
  </div>
</BaseLayout>
