---
const base = import.meta.env.BASE_URL;
const tracks = [
  { title: '静水微光', src: `${base}audio/still-waters.mp3` },
  { title: '灯下书页', src: `${base}audio/lamp-and-pages.mp3` },
  { title: '安静同行', src: `${base}audio/quiet-path.mp3` },
];
---

<aside class="music-player" data-music-player aria-label="安静音乐">
  <button class="music-main" type="button" data-music-toggle aria-pressed="false">
    <span class="music-icon" aria-hidden="true">♪</span>
    <span><strong data-music-title>静水微光</strong><small data-music-status aria-live="polite">1 / 3 · 点击播放</small></span>
  </button>
  <div class="music-skip" aria-label="切换曲目">
    <button type="button" data-music-prev aria-label="上一首">‹</button>
    <button type="button" data-music-next aria-label="下一首">›</button>
  </div>
  <input class="music-volume" data-music-volume type="range" min="0" max="1" step="0.05" value="0.24" aria-label="音乐音量" />
  <audio data-music-audio preload="metadata"></audio>
</aside>

<script define:vars={{ tracks }}>
  (() => {
    const player = document.querySelector('[data-music-player]');
    const audio = player?.querySelector('[data-music-audio]');
    const toggle = player?.querySelector('[data-music-toggle]');
    const title = player?.querySelector('[data-music-title]');
    const status = player?.querySelector('[data-music-status]');
    const volume = player?.querySelector('[data-music-volume]');
    const prev = player?.querySelector('[data-music-prev]');
    const next = player?.querySelector('[data-music-next]');
    if (!audio || !toggle || !title || !status || !volume) return;

    let index = Number(localStorage.getItem('quiet-room-track') || 0);
    if (!Number.isInteger(index) || index < 0 || index >= tracks.length) index = 0;
    const savedVolume = Number(localStorage.getItem('quiet-room-volume'));
    if (Number.isFinite(savedVolume) && savedVolume >= 0 && savedVolume <= 1) volume.value = String(savedVolume);
    audio.volume = Number(volume.value);

    const render = () => {
      title.textContent = tracks[index].title;
      if (audio.paused) status.textContent = `${index + 1} / ${tracks.length} · 点击播放`;
      localStorage.setItem('quiet-room-track', String(index));
    };
    const load = () => {
      audio.src = tracks[index].src;
      render();
    };
    const play = async () => {
      try {
        if (!audio.src) load();
        await audio.play();
        toggle.setAttribute('aria-pressed', 'true');
        status.textContent = `${index + 1} / ${tracks.length} · 正在播放`;
      } catch {
        toggle.setAttribute('aria-pressed', 'false');
        status.textContent = '播放被浏览器暂停 · 再试一次';
      }
    };
    const pause = () => {
      audio.pause();
      toggle.setAttribute('aria-pressed', 'false');
      render();
    };
    const move = async (delta, forcePlay = false) => {
      const wasPlaying = forcePlay || !audio.paused;
      index = (index + delta + tracks.length) % tracks.length;
      load();
      if (wasPlaying) await play();
    };

    load();
    toggle.addEventListener('click', () => audio.paused ? play() : pause());
    prev?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    audio.addEventListener('ended', () => move(1, true));
    audio.addEventListener('error', () => {
      status.textContent = '当前曲目未能加载 · 已切换下一首';
      const shouldResume = toggle.getAttribute('aria-pressed') === 'true';
      window.setTimeout(() => move(1, shouldResume), 700);
    });
    volume.addEventListener('input', () => {
      audio.volume = Number(volume.value);
      localStorage.setItem('quiet-room-volume', volume.value);
    });
  })();
</script>
