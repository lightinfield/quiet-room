---
const base = import.meta.env.BASE_URL;
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="site-search-title">
  <div class="search-shell">
    <div class="search-head">
      <label id="site-search-title" for="site-search">搜索静室</label>
      <button class="icon-button" type="button" data-search-close aria-label="关闭搜索">×</button>
    </div>
    <input id="site-search" type="search" autocomplete="off" placeholder="输入经文、主题、书名或关键词…" />
    <p class="search-hint">可搜索标题、摘要、经文、信条与标签。</p>
    <div class="search-results" data-search-results aria-live="polite"></div>
  </div>
</dialog>

<script define:vars={{ base }}>
  const dialog = document.querySelector('[data-search-dialog]');
  const input = document.querySelector('#site-search');
  const results = document.querySelector('[data-search-results]');
  let index = [];

  const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
  }[char]));

  const loadIndex = async () => {
    if (index.length) return;
    const response = await fetch(`${base}search-index.json`);
    if (response.ok) index = await response.json();
  };

  const render = (query) => {
    const q = query.trim().toLocaleLowerCase('zh-CN');
    if (!q) {
      results.innerHTML = '<p class="search-empty">输入关键词后开始检索。</p>';
      return;
    }
    const tokens = q.split(/\s+/).filter(Boolean);
    const matches = index
      .map((item) => ({
        ...item,
        score: tokens.reduce((score, token) => score + (item.searchText.includes(token) ? 1 : 0), 0)
      }))
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score || b.timestamp - a.timestamp)
      .slice(0, 12);

    results.innerHTML = matches.length
      ? matches.map((item) => `
          <a class="search-result" href="${base}${item.href.replace(/^\//, '')}">
            <span class="search-result-section">${escapeHtml(item.sectionTitle)}</span>
            <strong>${escapeHtml(item.title)}</strong>
            <small>${escapeHtml(item.summary)}</small>
          </a>`).join('')
      : '<p class="search-empty">没有找到相关内容。试试经卷名、教义词或更短的关键词。</p>';
  };

  document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', async () => {
    await loadIndex();
    dialog.showModal();
    input.focus();
    render(input.value);
  }));
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  input?.addEventListener('input', () => render(input.value));
</script>
