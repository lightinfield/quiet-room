---
import { NAV, SITE } from '../data/site';
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL;
const url = (path: string) => `${base}${path.replace(/^\//, '')}`;
const localPathname = base !== '/' && pathname.startsWith(base)
  ? `/${pathname.slice(base.length)}`
  : pathname;
---

<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href={url('/study/')} aria-label={`${SITE.name}首页`}>
      <span>
        <strong>{SITE.name}</strong>
        <small>{SITE.subtitle}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {NAV.map((item) => {
        const absolutePath = item.href;
        const active = localPathname === absolutePath || (absolutePath !== '/study/' && localPathname.startsWith(absolutePath));
        return <a href={url(item.href)} aria-current={active ? 'page' : undefined}>{item.title}</a>;
      })}
    </nav>

    <div class="header-actions">
      <button class="icon-button" type="button" data-search-open aria-label="搜索静室" title="搜索">⌕</button>
      <button class="icon-button" type="button" data-theme-toggle aria-label="切换深浅主题" title="深浅主题">☼</button>
      <button class="icon-button mobile-only" type="button" data-menu-toggle aria-label="打开导航" aria-expanded="false" title="导航">☰</button>
    </div>
  </div>

  <nav class="mobile-nav" data-mobile-nav aria-label="移动端导航" hidden>
    {NAV.map((item) => <a href={url(item.href)}>{item.title}</a>)}
  </nav>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const saved = localStorage.getItem('quiet-room-theme');
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = saved || (systemDark ? 'dark' : 'light');

    const themeButton = document.querySelector('[data-theme-toggle]');
    themeButton?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('quiet-room-theme', next);
      themeButton.textContent = next === 'dark' ? '☾' : '☼';
    });
    if (themeButton) themeButton.textContent = root.dataset.theme === 'dark' ? '☾' : '☼';

    const menuButton = document.querySelector('[data-menu-toggle]');
    const mobileNav = document.querySelector('[data-mobile-nav]');
    menuButton?.addEventListener('click', () => {
      const opening = mobileNav?.hasAttribute('hidden');
      mobileNav?.toggleAttribute('hidden', !opening);
      menuButton.setAttribute('aria-expanded', String(Boolean(opening)));
    });
  })();
</script>
